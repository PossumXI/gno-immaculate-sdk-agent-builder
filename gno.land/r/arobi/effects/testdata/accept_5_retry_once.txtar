# Acceptance 5: a retry with the same idempotency key does not apply the effect twice. The retry of a COMMITTED
# effect returns that effect and starts nothing; its steps are refused, and the state is what one run left.
# scripts/run-effects-txtars.sh adds the loadpkg lines and the packages.

adduser cleanup 100000000000ugnot

gnoland start

gnokey maketx call -pkgpath gno.land/r/arobi/assurance -func RegisterAgent -args worker-1 -args 'Worker 1' -args 1111111111111111111111111111111111111111111111111111111111111111 -args '' -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!

gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args ledger:bob -args invoice-77 -args 1 -args COMPENSABLE -args 'refund invoice 77' -args b1 -args paid -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\(1 uint64\)'
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func DemoStep -args 1 -args 1 -args 1 -args paid -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func CloseDemoEffect -args 1 -args 1 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\("COMMITTED" string\)'

# The agent retries, as a client does after a timeout: same key, same idempotency key, same attempt.
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args ledger:bob -args invoice-77 -args 1 -args COMPENSABLE -args 'refund invoice 77' -args b1 -args paid -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\(1 uint64\)'
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.EffectCount()'
stdout '\(1 uint64\)'
! gnokey maketx call -pkgpath gno.land/r/arobi/effects -func DemoStep -args 1 -args 1 -args 1 -args paid -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'effect 1 is COMMITTED'

# A retry under a new attempt number does not get around it, and the idempotency key stays bound to its effect key.
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args ledger:bob -args invoice-77 -args 2 -args COMPENSABLE -args 'refund invoice 77' -args b1 -args paid -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\(1 uint64\)'
! gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args ledger:carol -args invoice-77 -args 1 -args COMPENSABLE -args 'refund invoice 77' -args c1 -args paid -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'belongs to effect key ledger:bob'
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.EffectCount()'
stdout '\(1 uint64\)'
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.DemoValue("b1")'
stdout '\("paid" string\)'
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.VerifyEffect(1)'
stdout '\("COMMITTED" string\)'
