# Acceptance 6: a step that exits 0 and changed nothing does not close as COMMITTED. Its read-back shows the
# pre-state, and "nothing seen" is not yet "no effect": before the effect is fenced the close is IN_DOUBT (something
# sent under it could still land, and a retry would then apply it twice). Once it is fenced, the same read-back closes
# it as ABORTED, and only then may a retry start, as the next attempt.
# scripts/run-effects-txtars.sh adds the loadpkg lines and the packages.

adduser cleanup 100000000000ugnot

gnoland start

gnokey maketx call -pkgpath gno.land/r/arobi/assurance -func RegisterAgent -args worker-1 -args 'Worker 1' -args 1111111111111111111111111111111111111111111111111111111111111111 -args '' -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!

gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args site:prod -args deploy-9 -args 1 -args COMPENSABLE -args 'redeploy the previous build' -args live -args build-9 -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\(1 uint64\)'

# The deploy step reports success but writes nothing: the key keeps the value it had (none).
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func DemoStep -args 1 -args 1 -args 1 -args '' -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func CloseDemoEffect -args 1 -args 1 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\("IN_DOUBT" string\)'
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.OpenEffects()'
stdout 'id\\":1,'

# A retry is refused while the first attempt is in doubt.
! gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args site:prod -args deploy-9 -args 2 -args COMPENSABLE -args 'redeploy the previous build' -args live -args build-9 -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'has open effect 1 \(IN_DOUBT\)'

# The cleanup owner fences the effect: nothing more is accepted under it. The same read-back now closes it ABORTED.
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func FenceEffect -args 1 -args 1 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test cleanup
stdout OK!
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.EffectLive(1, 1)'
stdout '\(false bool\)'
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func CloseDemoEffect -args 1 -args 1 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test cleanup
stdout '\("ABORTED" string\)'
gnokey query vm/qeval --data 'gno.land/r/arobi/effects.VerifyEffect(1)'
stdout '\("ABORTED" string\)'

# Now the retry starts, as attempt 2, and a call naming attempt 1 is refused on it.
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func BeginDemoEffect -args worker-1 -args site:prod -args deploy-9 -args 2 -args COMPENSABLE -args 'redeploy the previous build' -args live -args build-9 -args 10 -args $cleanup_user_addr -args 0 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\(2 uint64\)'
! gnokey maketx call -pkgpath gno.land/r/arobi/effects -func DemoStep -args 2 -args 1 -args 1 -args build-9 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stderr 'a call for another attempt is refused'
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func DemoStep -args 2 -args 2 -args 1 -args build-9 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout OK!
gnokey maketx call -pkgpath gno.land/r/arobi/effects -func CloseDemoEffect -args 2 -args 2 -gas-fee 5000001ugnot -gas-wanted 50000000 -chainid=tendermint_test test1
stdout '\("COMMITTED" string\)'
